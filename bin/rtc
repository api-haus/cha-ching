#!/usr/bin/env bash
# realtokencost (rtc) — what the context in front of you actually costs.
#
# The window is re-sent on every request, so the price of a message is set by the
# conversation you are carrying rather than by the question you are asking. This
# shows that price before you press enter, and whether the prompt cache is still
# alive — a lapsed one rewrites the whole window at twenty times the read rate.
#
# Claude Code hands cost and context-window figures to the statusline and to
# nothing else. Hook payloads carry neither, and the request to expose context
# to hooks was closed as a duplicate. So this sits in the statusLine slot,
# harvests both, and hands the payload straight on to whatever statusline you
# already run.
#
#   rtc statusline   harvest, render, chain   (what statusLine.command runs)
#   rtc hook         context band warnings    (wired by the plugin)
#   rtc setup        claim the statusLine slot, keeping what was there
#   rtc uninstall    give it back
#   rtc doctor       explain why it is quiet
set -u

# Money and percentages are text all the way through here. Under a comma-decimal
# locale awk and printf disagree about what "9.76" means and the arithmetic
# silently stops working.
export LC_ALL=C

SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
HERE=$(dirname "$SELF")
ROOT=$(dirname "$HERE")
RUN=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/realtokencost"
CONFIG="$CONFIG_DIR/config"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/realtokencost"
SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"

# Config is a file rather than shell exports because hooks and the statusline are
# launched by Claude Code, which need not have inherited your shell's env. A real
# environment variable still wins.
if [ -r "$CONFIG" ]; then
  while IFS='=' read -r key value; do
    case "$key" in
      RTC_*)
        value=${value%\"}; value=${value#\"}
        [ -z "${!key:-}" ] && export "$key=$value"
        ;;
    esac
  done < "$CONFIG"
fi

FADE=${RTC_FADE:-4}          # seconds for the floating number to die
COOLDOWN=${RTC_COOLDOWN:-3}  # seconds between rings; spend in between accrues
MIN=${RTC_MIN:-0.005}        # spend below this is not worth a sound
BANDS=${RTC_BANDS:-10}       # announce context every N percent
ESTIMATE=${RTC_ESTIMATE:-1}  # 0 hides the [~$0.42] next-message estimate
SAMPLES=${RTC_SAMPLES:-6}    # completed turns kept to calibrate the estimate

die() { printf '%s\n' "$*" >&2; exit 1; }
now_s() { date +%s.%N 2>/dev/null || date +%s; }

# ── statusline ────────────────────────────────────────────────────────────────
cmd_statusline() {
  local payload model effort used size cost session
  payload=$(cat)

  IFS=$'\t' read -r model effort used size cost session prompt cwrite cread transcript modelid < <(
    printf '%s' "$payload" | jq -r '
      [ (.model.display_name // "?"),
        (.effort.level // "-"),
        (.context_window.total_input_tokens // 0),
        (.context_window.context_window_size // 0),
        (.cost.total_cost_usd // 0),
        (.session_id // ""),
        (.prompt_id // "-"),
        (.context_window.current_usage.cache_creation_input_tokens // 0),
        (.context_window.current_usage.cache_read_input_tokens // 0),
        (.transcript_path // ""),
        (.model.id // "unknown" | gsub("[^A-Za-z0-9._-]"; "_"))
      ] | @tsv' 2>/dev/null
  )
  [ -n "${model:-}" ] || exit 0

  # What a bare submit costs per million tokens is a property of the model, not
  # of the session — it is essentially the cache-read rate. Learning it once and
  # keeping it means a new session shows a figure on its first turn instead of
  # spending two turns rediscovering a constant.
  local ratefile="$CACHE_DIR/rate-${modelid:-unknown}"

  local now state last pending ring_ts shown shown_ts prev_prompt turn_cost turn_ctx last_call ttl ring=0
  now=$(now_s)
  state="$RUN/rtc-${session:-nosession}.state"

  last=""; pending=0; ring_ts=0; shown=0; shown_ts=0; prev_prompt="-"; turn_cost=""; turn_ctx=0
  last_call=0; ttl=0
  [ -r "$state" ] && IFS=' ' read -r last pending ring_ts shown shown_ts prev_prompt turn_cost turn_ctx last_call ttl < "$state" 2>/dev/null

  # A session knows nothing about its own context until its first response lands,
  # so a turn that opened before that has 0 recorded against it and would be
  # thrown away by the guard below — leaving a restarted session with no estimate
  # for as long as it takes to complete two more turns. Adopt the first real
  # figure that appears instead.
  if [ "${turn_ctx:-0}" -le 0 ] && [ "${used:-0}" -gt 0 ]; then turn_ctx=$used; fi

  if [ -z "${last:-}" ]; then
    # First sight. Adopt the total silently — announcing a session's whole
    # accumulated spend as a single hit would be a lie.
    :
  else
    # Every bump accrues. The ring is rate-limited, not the accounting, so a
    # tool-heavy turn lands as a few weighty numbers instead of a stream of
    # small ones, and nothing is ever dropped.
    # A bump means a request completed, which is also the moment the cache was
    # last touched — and therefore when its clock restarted.
    awk -v c="$cost" -v l="$last" 'BEGIN { exit !(c - l > 0) }' && last_call=$now

    pending=$(awk -v p="${pending:-0}" -v c="$cost" -v l="$last" \
      'BEGIN { d = c - l; printf "%.6f", p + (d > 0 ? d : 0) }')

    if awk -v p="$pending" -v m="$MIN" -v n="$now" -v r="${ring_ts:-0}" -v cd="$COOLDOWN" \
        'BEGIN { exit !(p >= m && n - r >= cd) }'; then
      ring=1
      shown=$pending
      shown_ts=$now
      ring_ts=$now
      pending=0
    fi
  fi

  # A completed turn is the only honest unit to predict from. prompt_id changes
  # when a new prompt starts, so its previous value bounds the turn that just
  # ended: what it cost, and how much context it was re-reading while it ran.
  # Store the ratio, not the cost — that is what carries to a bigger window.
  if [ "$prompt" != "$prev_prompt" ]; then
    if [ -n "${turn_cost:-}" ] && [ "${turn_ctx:-0}" -gt 1000 ]; then
      # A turn whose last request wrote more than it read rebuilt the cache. That
      # is an event, not a working pattern, so it is filed separately: it must
      # never set the warm expectation, and it is the only honest measure of what
      # a rebuild costs.
      local bucket=turns
      [ "${cwrite:-0}" -gt "${cread:-0}" ] && bucket=rebuilds
      local sample
      sample=$(awk -v c0="$turn_cost" -v c1="$cost" -v ctx="$turn_ctx" \
        'BEGIN { d = c1 - c0; if (d > 0) printf "%.6f", d / (ctx / 1000000) }')
      if [ -n "$sample" ]; then
        printf '%s\n' "$sample" >> "$RUN/rtc-${session:-nosession}.$bucket" 2>/dev/null || true
        # Only ordinary turns teach the model rate. A rebuild describes an event.
        if [ "$bucket" = turns ]; then
          mkdir -p "$CACHE_DIR" 2>/dev/null &&
            printf '%s\n' "$sample" >> "$ratefile" 2>/dev/null &&
            tail -n 20 "$ratefile" > "$ratefile.tmp" 2>/dev/null &&
            mv -f "$ratefile.tmp" "$ratefile" 2>/dev/null || true
        fi
      fi
      # Keep only recent turns: a session's shape changes as the work changes.
      tail -n "$SAMPLES" "$RUN/rtc-${session:-nosession}.$bucket" \
        > "$RUN/rtc-${session:-nosession}.$bucket.tmp" 2>/dev/null &&
        mv -f "$RUN/rtc-${session:-nosession}.$bucket.tmp" \
              "$RUN/rtc-${session:-nosession}.$bucket" 2>/dev/null || true
    fi
    prev_prompt=$prompt
    turn_cost=$cost
    turn_ctx=$used
    # Which TTL this session is on decides when the window goes cold, and only
    # the transcript names it. Read once per turn, never per render.
    [ -n "${transcript:-}" ] && ttl=$(detect_ttl "$transcript" || printf '%s' "${ttl:-0}")
  fi

  printf '%s %s %s %s %s %s %s %s %s %s\n' "$cost" "$pending" "$ring_ts" "$shown" "$shown_ts" \
    "$prev_prompt" "${turn_cost:-$cost}" "${turn_ctx:-$used}" "${last_call:-0}" "${ttl:-0}" \
    > "$state.tmp" 2>/dev/null && mv -f "$state.tmp" "$state" 2>/dev/null || true

  # Context, parked where the band hook can read it.
  printf '%s %s\n' "$used" "$size" > "$RUN/rtc-${session:-nosession}.ctx" 2>/dev/null || true

  [ "$ring" = 1 ] && play_sound

  local segment="" chain=""
  if [ "${RTC_SEGMENT:-1}" != "0" ]; then
    # A render is three processes and the statusline re-runs every second for
    # every open session — measured at 38% of a core across two dozen of them.
    # Most of those renders have nothing new to say, so the line is cached and
    # only rebuilt when something it depends on moves. A fade in progress
    # changes the line every frame and is never cached.
    local cache key fading=0 age fade_int=${FADE%.*} minute=0
    cache="$RUN/rtc-${session:-nosession}.line"
    # The cache clock moves on its own, so the key carries a minute counter —
    # otherwise a window could go cold behind a cached line that still claims it
    # is warm. One extra render a minute, not one a second.
    [ "${ttl:-0}" != "0" ] && [ "${last_call%.*}" != "0" ] &&
      minute=$(( ( ${now%.*} - ${last_call%.*} ) / 60 ))
    key="$used|$size|$cost|$prompt|$minute"

    if [ "${shown_ts%.*}" != "0" ]; then
      age=$(( ${now%.*} - ${shown_ts%.*} ))
      [ "$age" -le "$((fade_int + 1))" ] && fading=1
    fi

    if [ "$fading" = 0 ] && [ -r "$cache" ]; then
      local cached_key cached_line
      { read -r cached_key; read -r cached_line; } < "$cache" 2>/dev/null
      [ "${cached_key:-}" = "$key" ] && segment=$cached_line
    fi

    if [ -z "$segment" ]; then
      local est=""
      [ "$ESTIMATE" != "0" ] && est=$(estimate "${session:-nosession}" "$used" "${last_call:-0}" "${ttl:-0}" "$now" "$ratefile" 2>/dev/null)
      segment=$(render "$model" "$effort" "$used" "$size" "$cost" "$shown" "$shown_ts" "$now" "${est:-}")
      [ "$fading" = 0 ] && {
        printf '%s\n%s\n' "$key" "$segment" > "$cache.tmp" 2>/dev/null &&
          mv -f "$cache.tmp" "$cache" 2>/dev/null || true
      }
    fi
  fi

  if [ -n "${RTC_CHAIN:-}" ]; then
    chain=$(printf '%s' "$payload" | eval "${RTC_CHAIN}" 2>/dev/null)
  fi

  if [ -n "$segment" ] && [ -n "$chain" ]; then
    printf '%s  %s' "$segment" "$chain"
  else
    printf '%s%s' "$segment" "$chain"
  fi
}

# What the next message will cost, learned from this session rather than from a
# price table that would go stale the day rates move.
#
# The dominant term is re-reading the context you already have, which scales with
# window size — so what carries between turns is the ratio, dollars per million
# tokens of context, not the dollar figure itself. Median rather than mean: one
# turn that read forty files should not set the expectation for the next.
# Which prompt-cache TTL this session is on. The statusline payload gives only a
# flat cache_creation figure, but the transcript breaks it out by TTL, so the
# answer is read from there — once per turn, never per render.
detect_ttl() {
  local t="$1" line
  [ -r "$t" ] || return 1
  if command -v tac >/dev/null 2>&1; then
    line=$(tac "$t" 2>/dev/null | grep -m1 'ephemeral_1h_input_tokens')
  else
    line=$(tail -r "$t" 2>/dev/null | grep -m1 'ephemeral_1h_input_tokens')
  fi
  [ -n "$line" ] || return 1
  printf '%s' "$line" | jq -r '
    (.message.usage.cache_creation // {}) as $c
    | if   ($c.ephemeral_1h_input_tokens // 0) > 0 then 3600
      elif ($c.ephemeral_5m_input_tokens // 0) > 0 then 300
      else empty end' 2>/dev/null
}

# Emits "<dollars> <state> <seconds_left> <samples>" — the bare cost of
# submitting this context, and how long that price holds.
#
# What the turn then does is not estimable: whether Claude answers in one word or
# makes twenty tool calls is a property of the work, not of the context. But
# submission itself is fixed the moment you press enter, and its price has two
# values, not one. A cached window is re-READ at the cache-read rate. An expired
# one is re-WRITTEN, twenty times dearer on the 1-hour TTL, and which of the two
# you get is knowable: the clock started when the last request completed.
#
# Warm cost comes from the cheapest ordinary turn — one API call, a submit plus a
# few tokens of reply. Cold cost comes from an observed rebuild if this session
# has suffered one, and otherwise from the write/read price ratio.
estimate() {
  local sess="$1" ctx="$2" last_call="$3" ttl="$4" now="$5" ratefile="$6"
  local turns="$RUN/rtc-$sess.turns" cold="$RUN/rtc-$sess.rebuilds"
  # This session's own turns are the better evidence. Fall back to what this
  # model has taught us before, so a fresh session is not blind.
  [ -r "$turns" ] || turns="$ratefile"
  [ -r "$turns" ] || return 1
  [ "${ctx:-0}" -gt 0 ] || return 1
  awk -v ctx="$ctx" -v coldf="$cold" -v lc="$last_call" -v ttl="$ttl" -v now="$now" '
    { if (n == 0 || $1 + 0 < lo) lo = $1 + 0; n++ }
    END {
      if (n < 1 || lo <= 0) exit 1
      warm = lo * (ctx / 1000000)

      # A measured rebuild beats an asserted ratio. Fall back to write/read only
      # when this session has not yet paid for one.
      cr = 0
      while ((getline v < coldf) > 0) if (cr == 0 || v + 0 < cr) cr = v + 0
      close(coldf)
      cold = (cr > 0) ? cr * (ctx / 1000000) : warm * (ttl >= 3600 ? 20 : 12.5)

      if (lc + 0 <= 0 || ttl + 0 <= 0) { printf "%.2f warm 0 %d", warm, n; exit }

      left = ttl - (now - lc)
      if      (left <= 0)  printf "%.2f cold 0 %d", cold, n
      else if (left < 300) printf "%.2f expiring %d %d", warm, left, n
      else                 printf "%.2f warm %d %d", warm, left, n
    }' "$turns"
}

render() {
  awk -v model="$1" -v effort="$2" -v used="$3" -v size="$4" -v cost="$5" \
      -v delta="$6" -v dts="$7" -v now="$8" -v est="$9" -v fade="$FADE" '
  function scale(n) { return n >= 1000000 ? sprintf("%.2fM", n/1000000) : sprintf("%.0fk", n/1000) }
  function rgb(r, g, b) { return sprintf("\033[38;2;%d;%d;%dm", r, g, b) }
  BEGIN {
    RESET = "\033[0m"; DIM = "\033[2m"
    out = DIM model RESET
    if (effort != "-" && effort != "null" && effort != "") out = out " " DIM effort RESET

    if (size > 0) {
      pct = used / size * 100
      filled = int(pct / 10); if (filled > 10) filled = 10
      bar = ""
      for (i = 0; i < 10; i++) bar = bar (i < filled ? "█" : "░")

      # Truncate, never round. The figure must not overstate, and must agree
      # with the bar sitting next to it.
      shown = pct < 10 ? sprintf("%.1f", int(pct*10)/10) : sprintf("%d", int(pct))
      colour = pct >= 80 ? rgb(248,113,113) : (pct >= 50 ? rgb(251,191,36) : rgb(74,222,128))
      out = out " " colour bar " " shown "%" RESET
      out = out " " DIM scale(used) " / " scale(size) RESET
    }
    out = out sprintf(" %s$%.2f%s", DIM, cost, RESET)

    # What the next message is likely to cost, before it is sent. Dim while a
    # single turn is carrying the whole guess; full blue once the median has
    # enough behind it to survive one unusual turn.
    # Blue while the window is cached, amber as the clock runs down with the
    # minutes left, red once it has lapsed — where the figure is no longer a
    # re-read but a full rewrite, and the arrow says so.
    if (est != "") {
      split(est, e, " ")
      young = (e[4] + 0 < 3) ? DIM : ""
      if (e[2] == "cold")
        out = out sprintf(" %s%s[~$%s ⟳]%s", young, rgb(248,113,113), e[1], RESET)
      else if (e[2] == "expiring")
        out = out sprintf(" %s%s[~$%s · %dm]%s", young, rgb(251,191,36), e[1], int(e[3] / 60) + 1, RESET)
      else
        out = out sprintf(" %s%s[~$%s]%s", young, rgb(96,165,250), e[1], RESET)
    }

    # The floating number. Age drives it, so a render landing at any moment gets
    # the right colour rather than a fixed frame.
    age = now - dts
    if (dts > 0 && delta > 0 && age < fade) {
      t = age / fade
      k = t < 0.15 ? 0 : (t - 0.15) / 0.85     # holds bright for a beat, then falls
      bold = t < 0.15 ? "\033[1m" : ""
      out = out sprintf("  %s%s+$%.2f%s", bold, rgb(134 + (26-134)*k, 239 + (48-239)*k, 172 + (36-172)*k), delta, RESET)
    }
    printf "%s", out
  }'
}

play_sound() {
  [ "${RTC_MUTE:-0}" = "1" ] && return 0
  local wav p
  wav=${RTC_SOUND:-$ROOT/share/cash-register.wav}
  [ -s "$wav" ] || return 0
  for p in pw-play paplay aplay afplay; do
    if command -v "$p" >/dev/null 2>&1; then
      # Detached, so a wedged audio server never stalls a render.
      (setsid "$p" "$wav" >/dev/null 2>&1 &) 2>/dev/null
      return 0
    fi
  done
}

# ── context band hook ─────────────────────────────────────────────────────────
cmd_hook() {
  local payload session ctx used size band last state
  payload=$(cat)
  session=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
  [ -n "$session" ] || exit 0

  ctx="$RUN/rtc-${session}.ctx"
  if [ ! -r "$ctx" ]; then
    # Installed but never set up. The hooks wire themselves and the statusline
    # cannot, so this is the one failure mode a new user will actually hit —
    # say it once rather than sitting there silently doing nothing.
    local nudge="$RUN/rtc-${session}.nudged"
    if [ ! -e "$nudge" ] && ! jq -e '.statusLine.command // "" | test("realtokencost")' "$SETTINGS" >/dev/null 2>&1; then
      : > "$nudge" 2>/dev/null || true
      jq -n '{systemMessage: "realtokencost is installed but not wired to the statusline, which is the only place Claude Code exposes cost and context. Run /realtokencost:setup"}'
    fi
    exit 0
  fi
  IFS=' ' read -r used size < "$ctx" 2>/dev/null
  case "${used:-}${size:-}" in ''|*[!0-9]*) exit 0 ;; esac
  [ "${size:-0}" -gt 0 ] || exit 0

  band=$(( used * 100 / size / BANDS ))
  [ "$band" -ge 1 ] || exit 0

  state="$RUN/rtc-${session}.band"
  last=0
  [ -r "$state" ] && last=$(cat "$state" 2>/dev/null)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ "$band" -gt "$last" ] || exit 0             # once per band, on the way up
  printf '%s' "$band" > "$state" 2>/dev/null || true

  jq -n --arg m "context $(( band * BANDS ))% used — $(human "$used") of $(human "$size") tokens" \
    '{systemMessage: $m}'
}

human() { awk -v n="$1" 'BEGIN { printf (n >= 1000000 ? "%.2fM" : "%.0fk"), n / (n >= 1000000 ? 1000000 : 1000) }'; }

# ── setup ─────────────────────────────────────────────────────────────────────
cmd_setup() {
  command -v jq >/dev/null 2>&1 || die "realtokencost needs jq."
  [ -f "$SETTINGS" ] || die "no settings.json at $SETTINGS"

  local current backup tmp
  current=$(jq -r '.statusLine.command // empty' "$SETTINGS")

  # Never chain to ourselves, under any name we have ever had. Re-running setup,
  # moving from a checkout to an installed copy, or renaming the project would
  # otherwise wire this into its own chain and render the gauge twice, with the
  # two copies fighting over one state file. The rename to realtokencost proved
  # the point: a guard that knew only the current name promptly chained the
  # abandoned cha-ching binary, which was still sitting in the plugin cache.
  if [ -n "$current" ] && [ "$current" != "$SELF" ] &&
     ! printf '%s' "$current" | grep -qE 'realtokencost|cha-ching|/rtc([[:space:]]|$)'; then
    mkdir -p "$CONFIG_DIR"
    if grep -q '^RTC_CHAIN=' "$CONFIG" 2>/dev/null; then
      printf 'keeping the chain already in %s\n' "$CONFIG"
    else
      printf 'RTC_CHAIN=%s\n' "$current" >> "$CONFIG"
      printf 'chaining to your existing statusline: %s\n' "$current"
    fi
  fi

  backup="$SETTINGS.realtokencost.bak"
  cp "$SETTINGS" "$backup"
  tmp=$(mktemp)
  jq --arg cmd "$SELF" \
     '.statusLine = {"type":"command","command":$cmd,"refreshInterval":1}' \
     "$SETTINGS" > "$tmp" && jq empty "$tmp" && mv "$tmp" "$SETTINGS" \
    || die "failed to write $SETTINGS (backup at $backup)"

  printf 'statusLine claimed. Backup at %s\n' "$backup"
  printf 'Restart Claude Code.\n'
}

cmd_uninstall() {
  local chain tmp
  chain=$(sed -n 's/^RTC_CHAIN=//p' "$CONFIG" 2>/dev/null | head -1)
  tmp=$(mktemp)
  if [ -n "$chain" ]; then
    jq --arg cmd "$chain" '.statusLine = {"type":"command","command":$cmd}' "$SETTINGS" > "$tmp"
    printf 'restored your statusline: %s\n' "$chain"
  else
    jq 'del(.statusLine)' "$SETTINGS" > "$tmp"
    printf 'removed the statusline entry.\n'
  fi
  jq empty "$tmp" && mv "$tmp" "$SETTINGS" || die "failed to write $SETTINGS"
  printf 'Config left at %s — delete it if you are done.\n' "$CONFIG"
}

# ── doctor ────────────────────────────────────────────────────────────────────
cmd_doctor() {
  local ok p found wired
  printf 'rtc doctor\n\n'

  if command -v jq >/dev/null 2>&1; then printf '  jq          %s\n' "$(command -v jq)"
  else printf '  jq          MISSING — nothing works without it\n'; fi

  found=""
  for p in pw-play paplay aplay afplay; do
    command -v "$p" >/dev/null 2>&1 && { found=$p; break; }
  done
  if [ -n "$found" ]; then printf '  player      %s\n' "$found"
  else printf '  player      none of pw-play/paplay/aplay/afplay — it will be silent\n'; fi

  if [ -s "$ROOT/share/cash-register.wav" ]; then printf '  sound       %s\n' "$ROOT/share/cash-register.wav"
  else printf '  sound       MISSING at %s\n' "$ROOT/share/cash-register.wav"; fi

  wired=$(jq -r '.statusLine.command // "none"' "$SETTINGS" 2>/dev/null)
  if [ "$wired" = "$SELF" ]; then
    printf '  statusLine  wired (refreshInterval %s)\n' "$(jq -r '.statusLine.refreshInterval // "unset"' "$SETTINGS")"
  else
    printf '  statusLine  NOT wired — currently %s\n' "$wired"
    printf '              run: rtc setup\n'
  fi

  [ -n "${RTC_CHAIN:-}" ] && printf '  chain       %s\n' "$RTC_CHAIN"

  ok=$(ls "$RUN"/rtc-*.state 2>/dev/null | wc -l)
  printf '  live data   %s session(s) reporting\n' "$ok"

  # refreshInterval 1 re-runs this for every open session, every second. That is
  # cheap once and not cheap two dozen times, so show the arithmetic.
  if [ "$ok" -gt 0 ]; then
    printf '  render cost ~%dms each; %s session(s) at refreshInterval %s ≈ %s%% of a core\n' \
      10 "$ok" "$(jq -r '.statusLine.refreshInterval // 1' "$SETTINGS" 2>/dev/null)" \
      "$(awk -v n="$ok" -v r="$(jq -r '.statusLine.refreshInterval // 1' "$SETTINGS" 2>/dev/null)" \
         'BEGIN { printf "%.0f", 10 * n / (r > 0 ? r : 1) / 10 }')"
    [ "$ok" -gt 8 ] && printf '              many sessions — raising refreshInterval to 2 or 3 halves that\n'
  fi

  # Per session, never aggregated. Calibration belongs to one session's turn
  # history, so a total across sessions would report ready while the session you
  # are looking at has nothing.
  if [ "$ESTIMATE" = "0" ]; then
    printf '  estimate    off\n'
  else
    local f n any=0
    for f in "$RUN"/rtc-*.turns; do
      [ -r "$f" ] || continue
      n=$(wc -l < "$f")
      [ "$n" -gt 0 ] || continue
      any=1
      f=${f##*/rtc-}; f=${f%.turns}
      if [ "$n" -lt 3 ]; then
        printf '  estimate    %.8s — %s turn(s), showing a provisional figure (dim until 3)\n' "$f" "$n"
      else
        printf '  estimate    %.8s — %s turn(s), calibrated\n' "$f" "$n"
      fi
    done
    local rf
    for rf in "$CACHE_DIR"/rate-*; do
      [ -r "$rf" ] || continue
      any=1
      printf '  model rate  %s — %s sample(s), inherited by new sessions\n' \
        "${rf##*/rate-}" "$(wc -l < "$rf")"
    done
    [ "$any" = 0 ] && printf '  estimate    no completed turns recorded yet — send a message and it calibrates\n'
  fi
}

case "${1:-statusline}" in
  statusline) cmd_statusline ;;
  hook)       cmd_hook ;;
  setup)      cmd_setup ;;
  uninstall)  cmd_uninstall ;;
  doctor)     cmd_doctor ;;
  -h|--help|help)
    sed -n '2,16p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (try: statusline, hook, setup, uninstall, doctor)" ;;
esac
