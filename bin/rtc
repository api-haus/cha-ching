#!/usr/bin/env bash
# realtokencost (rtc) — what the context in front of you actually costs.
#
# The window is re-sent on every request, so the price of a message is set by the
# conversation you are carrying rather than by the question you are asking. This
# shows that price before you press enter, and whether the prompt cache is still
# alive — a lapsed one rewrites the whole window at twenty times the read rate.
#
# Claude Code hands cost and context-window figures to the statusline and to
# nothing else. Hook payloads carry neither, and the request to expose context
# to hooks was closed as a duplicate. So this sits in the statusLine slot,
# harvests both, and hands the payload straight on to whatever statusline you
# already run.
#
# Kimi Code has the same asymmetry with different names: [status_line].command
# in tui.toml gets a JSON snapshot (context but no cost — Kimi is
# subscription-based), and the per-request token usage lives in the session's
# wire.jsonl. So under Kimi the dollars are computed, not harvested: measured
# tokens times rates from `rtc rates` (models.dev) or an RTC_PRICE_* override.
# Nothing about prices is compiled in.
#
#   rtc statusline   harvest, render, chain   (what the status line command runs)
#   rtc hook         context band warnings    (wired by the plugin)
#   rtc halt         mark a turn handing back (wired by the plugin)
#   rtc setup        claim the status line slot, keeping what was there
#   rtc uninstall    give it back
#   rtc rates        fetch model prices from models.dev (Kimi money source)
#   rtc doctor       explain why it is quiet
set -u

# Money and percentages are text all the way through here. Under a comma-decimal
# locale awk and printf disagree about what "9.76" means and the arithmetic
# silently stops working.
export LC_ALL=C

SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
HERE=$(dirname "$SELF")
ROOT=$(dirname "$HERE")
RUN=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/realtokencost"
CONFIG="$CONFIG_DIR/config"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/realtokencost"
SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
KIMI_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
KIMI_TUI="$KIMI_HOME/tui.toml"
KIMI_CONF="$KIMI_HOME/config.toml"

# Config is a file rather than shell exports because hooks and the statusline are
# launched by Claude Code, which need not have inherited your shell's env. A real
# environment variable still wins.
if [ -r "$CONFIG" ]; then
  while IFS='=' read -r key value; do
    case "$key" in
      RTC_*)
        value=${value%\"}; value=${value#\"}
        [ -z "${!key:-}" ] && export "$key=$value"
        ;;
    esac
  done < "$CONFIG"
fi

FADE=${RTC_FADE:-4}          # seconds for the floating number to die
COOLDOWN=${RTC_COOLDOWN:-3}  # seconds between rings; spend in between accrues
MIN=${RTC_MIN:-0.005}        # spend below this is not worth a sound
BANDS=${RTC_BANDS:-10}       # announce context every N percent
ESTIMATE=${RTC_ESTIMATE:-1}  # 0 hides the [~$0.42] next-message estimate
SAMPLES=${RTC_SAMPLES:-12}   # recent requests kept to calibrate the estimate

# What releases the ring. The money is accounted the same way in all three —
# only the moment it is announced moves.
#
#   immediate             every bump over MIN, at most one ring per COOLDOWN
#   cumulative_threshold  once per THRESHOLD dollars, however long that takes
#   on_halt               when the turn hands back: work submitted, question
#                         asked, permission wanted
#
# The floating number keeps its own rhythm in every mode. It is free — it costs
# a glance you were already giving the statusline — whereas a sound interrupts,
# so the two do not have to fire together.
RING=${RTC_RING:-immediate}
THRESHOLD=${RTC_THRESHOLD:-5}

# Whose money the ring is counting. Ten sessions open at once are one person
# spending, one pair of ears and one budget, so the ear's state is shared by
# default: one ring per THRESHOLD dollars across the machine, one ring per
# COOLDOWN seconds across the machine. `session` gives each session its own
# accumulator and its own clock, which is what this did before the switch
# existed. The eye stays per session either way — the floating number belongs to
# the statusline it appears on.
SCOPE=${RTC_RING_SCOPE:-global}

die() { printf '%s\n' "$*" >&2; exit 1; }

# One request, one measurement: this much money bought a re-read of this much
# context. Requests whose last call wrote more than it read rebuilt the cache and
# are filed apart — they measure an event, not a rate. Recording per request
# rather than per turn is what lets a session show a figure within seconds of
# its first response instead of after two whole turns.
record_sample() {
  local bump="$1" ctx="$2" cw="$3" cr="$4" sess="$5" ratefile="$6" bucket=turns sample f
  [ "${ctx:-0}" -gt 1000 ] || return 0
  [ "${cw:-0}" -gt "${cr:-0}" ] && bucket=rebuilds
  sample=$(awk -v d="$bump" -v ctx="$ctx" 'BEGIN { printf "%.6f", d / (ctx / 1000000) }')
  [ -n "$sample" ] || return 0

  f="$RUN/$sess.$bucket"
  printf '%s\n' "$sample" >> "$f" 2>/dev/null || return 0
  tail -n "$SAMPLES" "$f" > "$f.tmp" 2>/dev/null && mv -f "$f.tmp" "$f" 2>/dev/null || true

  # Only ordinary requests teach the model rate.
  [ "$bucket" = turns ] || return 0
  mkdir -p "$CACHE_DIR" 2>/dev/null &&
    printf '%s\n' "$sample" >> "$ratefile" 2>/dev/null &&
    tail -n 40 "$ratefile" > "$ratefile.tmp" 2>/dev/null &&
    mv -f "$ratefile.tmp" "$ratefile" 2>/dev/null || true
}
now_s() { date +%s.%N 2>/dev/null || date +%s; }

# The shared ring state, in two numbers: when it last spoke, and what it has not
# announced yet. Read on every render under a global scope, so it is builtins
# only — no process starts to find out that nothing is due.
read_ring() {
  gts=0; gacc=0
  [ -r "$1" ] && IFS=' ' read -r gts gacc < "$1" 2>/dev/null
  case "${gts:-}" in ''|*[!0-9.]*) gts=0 ;; esac
  case "${gacc:-}" in ''|*[!0-9.]*) gacc=0 ;; esac
}

# Writing that state is a read-modify-write, and the statusline runs in a
# separate process for every open session, every second. Without a mutex two of
# them read the same $4.95, both add their bump, both cross $5 — two rings, and
# one of the two writes gone.
#
# flock is not on macOS and mkdir costs a fork, so this is bash's noclobber
# redirect: O_EXCL, from a builtin, no process at all, and it writes the
# acquisition time in the same syscall it takes the lock with. Verified under
# contention — 16 takers, 300 rounds, exactly one winner every round.
#
# stderr is redirected before the target rather than after it. Redirections are
# set up left to right, so a 2>/dev/null written last arrives too late to
# swallow the "cannot overwrite existing file" that the failing one prints.
#
# What the lock guards is a read and a write, so a session that loses waits and
# takes it — ten of them draining in turn cost a tenth of a render each. Giving
# up after a bounded spin rather than blocking is what keeps a wedged holder
# from taking the statusline down with it; the money a giver-up is carrying is
# safe where it is, and comes back on the next render.
ring_lock() {
  local f="$1" now="$2" held="" try=0
  # Ten waits of 20ms. The section is a read, an awk and a write — a few
  # milliseconds — so this covers every open session piling onto it at the same
  # instant, which is the shape of the worst case: they render on the same timer.
  while [ "$try" -lt 10 ]; do
    try=$((try + 1))
    set -C
    if printf '%s\n' "$now" 2>/dev/null > "$f"; then set +C; return 0; fi
    set +C

    # A process killed between taking this and releasing it would silence every
    # session on the machine for as long as the file survived, so a lock nobody
    # has released in five seconds is taken from it.
    held=0
    [ -r "$f" ] && read -r held < "$f" 2>/dev/null
    case "${held:-}" in ''|*[!0-9.]*) held=0 ;; esac
    if [ $(( ${now%.*} - ${held%.*} )) -gt 5 ]; then
      rm -f "$f" 2>/dev/null || true
      continue
    fi
    sleep 0.02 2>/dev/null || true
  done
  return 1
}

# ── kimi measurement ──────────────────────────────────────────────────────────
# Kimi Code is subscription-based and reports no cost anywhere, so under Kimi
# the dollars are computed, not harvested: the session's wire.jsonl carries one
# usage.record row per request with a full token breakdown, and those measured
# tokens are priced. Rates come from the config or from `rtc rates` — nothing
# about prices is compiled into this script.

# The four rates a Kimi request is priced with — input cache_read cache_write
# output, dollars per million tokens. An RTC_PRICE_<model> line in the config
# always wins; the models.dev cache written by `rtc rates` is the fallback.
# No rate, no money: the caller goes quiet about it rather than show a number
# it cannot stand behind.
# The four rates a Kimi request is priced with — input cache_read cache_write
# output, dollars per million tokens. Precedence: an RTC_PRICE_<model> config
# line always wins; then the models.dev cache written by `rtc rates`; then the
# bundled seed in share/prices.tsv, which exists so a fresh install shows money
# before any fetch has run — dated, marked, and never covering a model nobody
# sells by the token. No rate anywhere, no money: the caller goes quiet about
# it rather than show a number it cannot stand behind.
#
# Returns via globals, not stdout, so the source tier survives the call:
# PRICE holds the four rates, PRICE_SRC names the tier (override/cache/seed).
price_for() {
  PRICE=""; PRICE_SRC=""
  local key="RTC_PRICE_$(printf '%s' "$1" | tr -c 'A-Za-z0-9_' '_')" v=""
  v=${!key:-}
  if [ -n "$v" ]; then PRICE_SRC=override
  elif [ -r "$CACHE_DIR/price-$1" ]; then
    local a b c d
    IFS=' ' read -r a b c d _ < "$CACHE_DIR/price-$1" 2>/dev/null
    v="$a $b $c $d"
    PRICE_SRC=cache
  else
    # The seed is keyed by wire alias; read with builtins only, and only ever
    # reached when nothing fresher exists, so it costs no fork in steady state.
    local sa si scr scw so
    while IFS=$'\t' read -r sa si scr scw so _; do
      case "$sa" in ''|\#*) continue ;; esac
      if [ "${sa//[^A-Za-z0-9._-]/_}" = "$1" ]; then
        v="$si $scr $scw $so"
        PRICE_SRC=seed
        break
      fi
    done < "$ROOT/share/prices.tsv" 2>/dev/null
  fi
  [ "$(printf '%s' "$v" | wc -w)" = 4 ] || return 1
  case "$v" in ''|*[!0-9.\ ]*) return 1 ;; esac
  PRICE=$v
}

# The fetched cache rots like any table would, so it freshens itself: a model
# running on the bundled seed, or a price file older than
# RTC_RATES_MAX_AGE_DAYS, triggers one detached `rtc rates`, throttled by a
# marker so a fleet of concurrent renders spawns at most one fetch per
# interval. Renders only ever read the cache — the fetch replaces it
# atomically when it lands, and a failed fetch leaves the last good numbers.
rates_maybe_refresh() {
  [ "${RTC_RATES_REFRESH:-1}" = "0" ] && return 0   # 0 disables; on by default
  case "$PRICE_SRC" in override) return 0 ;; esac    # the user owns that number
  local need=0 m
  if [ "$PRICE_SRC" = cache ]; then
    m=$(stat -c %Y "$CACHE_DIR/price-$1" 2>/dev/null || stat -f %m "$CACHE_DIR/price-$1" 2>/dev/null || printf '0')
    case "$m" in ''|*[!0-9]*) m=0 ;; esac
    [ $(( ${now%.*} - m )) -gt $(( ${RTC_RATES_MAX_AGE_DAYS:-30} * 86400 )) ] && need=1
  else
    need=1    # seed or nothing: there is something fresher to fetch
  fi
  [ "$need" = 1 ] || return 0
  m=$(stat -c %Y "$CACHE_DIR/.rates-when" 2>/dev/null || stat -f %m "$CACHE_DIR/.rates-when" 2>/dev/null || printf '0')
  case "$m" in ''|*[!0-9]*) m=0 ;; esac
  # Six hours between attempts, however many renders ask — an offline machine
  # should not earn a curl every second.
  [ $(( ${now%.*} - m )) -lt 21600 ] && return 0
  mkdir -p "$CACHE_DIR" 2>/dev/null && : > "$CACHE_DIR/.rates-when" 2>/dev/null || return 0
  (setsid "$SELF" rates >/dev/null 2>&1 &) 2>/dev/null
}

# Reads the complete lines past the wire offset and folds the usage.record rows
# into sums. A partial last line — a request being written at this moment — is
# left for the next render: the offset only ever moves past a newline.
# Prints: new_offset inputOther cacheRead cacheCreate output alias
kimi_tail() {
  local wire="$1" off="$2" chunk complete
  chunk=$(tail -c +"$((off + 1))" -- "$wire" 2>/dev/null; printf x)
  chunk=${chunk%x}
  case "$chunk" in
    "")      complete="" ;;
    *$'\n')  complete=$chunk ;;
    *$'\n'*) complete=${chunk%$'\n'*}$'\n' ;;
    *)       complete="" ;;
  esac
  [ -n "$complete" ] || { printf '%s 0 0 0 0 \n' "$off"; return; }
  printf '%s' "$complete" | jq -Rr '
      fromjson? // empty | select(.type == "usage.record") |
      [ (.usage.inputOther // 0), (.usage.inputCacheRead // 0),
        (.usage.inputCacheCreation // 0), (.usage.output // 0),
        (.model // "") ] | @tsv' 2>/dev/null |
    awk -v off="$off" -v n="${#complete}" '
      { io+=$1; cr+=$2; cw+=$3; o+=$4; if ($5 != "") a=$5 }
      END { printf "%d %d %d %d %d %s", off + n, io, cr, cw, o, a }'
}

# Cost under Kimi is a running total this script maintains: tail the wire from
# the offset in the state file, price the new rows, add them in. What the
# session spent before rtc first saw its wire is adopted, never announced —
# the same rule as a first cost sighting under Claude.
#
# Runs inside cmd_statusline and edits its variables directly: cost, cwrite,
# cread, used, modelid, woffset, noprice.
kimi_measure() {
  local wiref="$RUN/$tag-$session.wire" wire="" walias="" wsize price=""
  if [ -r "$wiref" ]; then { read -r wire; read -r walias; } < "$wiref" 2>/dev/null; fi
  [ -n "$wire" ] && [ ! -f "$wire" ] && wire=""
  if [ -z "$wire" ]; then
    local d
    for d in "$KIMI_HOME/sessions/"*/"$session" "$KIMI_HOME/sessions/"*/"session_$session"; do
      if [ -f "$d/agents/main/wire.jsonl" ]; then wire="$d/agents/main/wire.jsonl"; break; fi
    done
    if [ -n "$wire" ]; then
      printf '%s\n%s\n' "$wire" "$walias" > "$wiref.tmp" 2>/dev/null &&
        mv -f "$wiref.tmp" "$wiref" 2>/dev/null || true
      woffset=-1
    fi
  fi
  [ -n "$wire" ] || { noprice=1; return; }

  # Kimi sends no running total, so rtc maintains it: every render starts from
  # what the state file carried, and new wire rows add to it below.
  cost=${last:-0}

  # The alias the wire reports ("kimi-code/k3") keys the learned rate and the
  # price, not the display name the snapshot sends.
  [ -n "$walias" ] && modelid=$(printf '%s' "$walias" | tr -c 'A-Za-z0-9._-' '_')
  price_for "${modelid:-unknown}" || noprice=1
  price=$PRICE
  rates_maybe_refresh "${modelid:-unknown}"

  wsize=$(stat -c %s "$wire" 2>/dev/null || stat -f %z "$wire" 2>/dev/null || printf '0')
  case "${wsize:-}" in ''|*[!0-9]*) noprice=1; return ;; esac

  if [ "$woffset" -lt 0 ] || [ "$wsize" -lt "$woffset" ]; then
    woffset=$wsize    # first sight, or a rotated wire: adopt, never recount
    return
  fi
  [ "$wsize" -gt "$woffset" ] || return 0

  local t nio=0 ncr=0 ncw=0 no=0 nal=""
  t=$(kimi_tail "$wire" "$woffset")
  IFS=' ' read -r woffset nio ncr ncw no nal <<< "$t"
  case "${woffset:-}" in ''|*[!0-9]*) noprice=1; return ;; esac
  if [ -n "$nal" ] && [ "$nal" != "$walias" ]; then
    walias=$nal
    modelid=$(printf '%s' "$walias" | tr -c 'A-Za-z0-9._-' '_')
    printf '%s\n%s\n' "$wire" "$walias" > "$wiref.tmp" 2>/dev/null &&
      mv -f "$wiref.tmp" "$wiref" 2>/dev/null || true
    if price_for "$modelid"; then noprice=0; price=$PRICE; fi
  fi
  [ $((nio + ncr + ncw + no)) -gt 0 ] || return 0
  [ "$noprice" = 0 ] || return 0

  # Priced like an API bill: plain input at the input rate, the cache halves at
  # theirs. A rate change rescales the measurement; it never rewrites it.
  cost=$(awk -v base="${last:-0}" -v io="$nio" -v cr="$ncr" -v cw="$ncw" -v o="$no" -v p="$price" \
    'BEGIN { split(p, r, " "); printf "%.6f", base + (io*r[1] + cr*r[2] + cw*r[3] + o*r[4]) / 1000000 }')
  cwrite=$ncw; cread=$ncr
  [ "${used:-0}" -gt 0 ] || used=$((nio + ncr + ncw))
}

# ── statusline ────────────────────────────────────────────────────────────────
cmd_statusline() {
  local payload platform model effort used size cost session
  payload=$(cat)

  # Two payload shapes share this entry point. Claude Code sends snake_case
  # with cost and context_window; Kimi Code sends a camelCase snapshot with
  # context but never cost (it is subscription-based), which is why cost is 0
  # here and computed from the wire log further down instead.
  IFS=$'\t' read -r platform model effort used size cost session prompt cwrite cread transcript modelid < <(
    printf '%s' "$payload" | jq -r '
      if .sessionId != null then
        [ "kimi",
          (if (.model // "") == "" then "?" else .model end),
          "-",
          (.contextTokens // 0),
          (.maxContextTokens // 0),
          0,
          (.sessionId // ""),
          "-",
          0, 0, "",
          "unknown"
        ] | @tsv
      else
        [ "claude",
          (.model.display_name // "?"),
          (.effort.level // "-"),
          (.context_window.total_input_tokens // 0),
          (.context_window.context_window_size // 0),
          (.cost.total_cost_usd // 0),
          (.session_id // ""),
          (.prompt_id // "-"),
          (.context_window.current_usage.cache_creation_input_tokens // 0),
          (.context_window.current_usage.cache_read_input_tokens // 0),
          (.transcript_path // ""),
          (.model.id // "unknown" | gsub("[^A-Za-z0-9._-]"; "_"))
        ] | @tsv
      end' 2>/dev/null
  )
  [ -n "${model:-}" ] || exit 0

  local now state tag last pending ring_ts shown shown_ts prev_prompt turn_cost turn_ctx last_call ttl
  local ring_acc woffset halt="" halted=0 pulse=0 ring=0 bump money carry=0 deferred=0
  local gring="" gts=0 gacc=0 locked=0 rts noprice=0
  now=$(now_s)
  tag=rtc
  [ "$platform" = kimi ] && tag=rtc-kimi
  state="$RUN/$tag-${session:-nosession}.state"

  last=""; pending=0; ring_ts=0; shown=0; shown_ts=0; prev_prompt="-"; turn_cost=""; turn_ctx=0
  last_call=0; ttl=0; ring_acc=0; woffset=0
  [ -r "$state" ] && IFS=' ' read -r last pending ring_ts shown shown_ts prev_prompt turn_cost turn_ctx last_call ttl ring_acc woffset < "$state" 2>/dev/null
  # A state file written before the ring had modes stops at ttl, and read leaves
  # the field it never wrote empty rather than absent. Same for woffset, which
  # only Kimi sessions use.
  [ -n "${ring_acc:-}" ] || ring_acc=0
  # -1 is the unset sentinel: 0 is a valid wire offset (an empty wire adopts at
  # size 0, and the first row appended must still count), so "never seen" has
  # to be its own value.
  case "${woffset:-}" in ''|*[!0-9-]*) woffset=-1 ;; esac

  if [ "$platform" = kimi ] && [ -n "${session:-}" ]; then
    kimi_measure
  fi

  # What a bare submit costs per million tokens is a property of the model, not
  # of the session — it is essentially the cache-read rate. Learning it once and
  # keeping it means a new session shows a figure on its first turn instead of
  # spending two turns rediscovering a constant.
  local ratefile="$CACHE_DIR/rate-${modelid:-unknown}"

  # The turn handed back while we were not looking. Consumed on sight whether or
  # not it becomes a ring — it happened once, and if no money moved with it there
  # is nothing to announce. Under a shared ring it is consumed only once this
  # session holds the lock, or a halt would be swallowed by a lock it lost.
  if [ "$RING" = on_halt ]; then
    halt="$RUN/$tag-${session:-nosession}.halt"
    if [ -e "$halt" ]; then
      halted=1
      [ "$SCOPE" = session ] && { rm -f "$halt" 2>/dev/null || true; }
    fi
  fi

  # A session knows nothing about its own context until its first response lands,
  # so a turn that opened before that has 0 recorded against it and would be
  # thrown away by the guard below — leaving a restarted session with no estimate
  # for as long as it takes to complete two more turns. Adopt the first real
  # figure that appears instead.
  if [ "${turn_ctx:-0}" -le 0 ] && [ "${used:-0}" -gt 0 ]; then turn_ctx=$used; fi

  if [ -z "${last:-}" ]; then
    # First sight. Adopt the total silently — announcing a session's whole
    # accumulated spend as a single hit would be a lie.
    :
  else
    # Every bump accrues, into two accumulators that are released on different
    # terms. `pending` is money the eye has not been shown; `ring_acc` is money
    # the ear has not been told about. Rate-limiting is applied to the release,
    # never to the accounting, so a tool-heavy turn lands as a few weighty
    # numbers instead of a stream of small ones and nothing is ever dropped.
    # A bump means a request completed, which is also the moment the cache was
    # last touched — and therefore when its clock restarted. It is also a
    # measurement: this much money bought a re-read of this much context.
    #
    # One awk decides all of it. This runs every second for every open session,
    # and each of these used to be a process of its own.
    rts=${ring_ts:-0}

    # Under a shared ring the ear's two numbers come from one file for the whole
    # machine instead of from this session's state, and the session's own
    # ring_acc changes meaning: it becomes money this session has accepted but
    # not yet handed over, which is only ever non-zero after a lost lock.
    if [ "$SCOPE" != session ]; then
      gring="$RUN/rtc-global-${UID:-0}.ring"
      read_ring "$gring"
      rts=$gts

      # Take the lock only when something can come of it: money has just
      # arrived, this session is still carrying money it failed to hand over, a
      # halt is waiting to be spent, or — in the modes where the clock alone can
      # release a ring — money is already sitting there with a cooldown that may
      # have expired since. A threshold holding $2.30 for ten minutes never
      # touches it. This is the render path, once a second for every open
      # session, and it is the reason the lock is affordable at all.
      #
      # The carried-money case is what keeps a lost race from becoming a lost
      # ring: a session that gave up is otherwise idle by every other test here,
      # and would sit on the money until it next spent some.
      local need=0
      [ "$cost" != "$last" ] && need=1
      [ "$halted" = 1 ] && need=1
      case "${ring_acc//[0.]/}" in ?*) need=1 ;; esac
      case "$RING" in
        cumulative_threshold|on_halt) ;;
        *) case "${gacc//[0.]/}" in ?*) need=1 ;; esac ;;
      esac

      if [ "$need" = 1 ] && ring_lock "$gring.lock" "$now"; then
        locked=1
        read_ring "$gring"     # the read above was a guess; this one is the truth
        rts=$gts
      fi
    fi

    money=$(awk -v c="$cost" -v l="$last" -v p="${pending:-0}" -v a="${ring_acc:-0}" \
                -v ga="$gacc" -v min="$MIN" -v cd="$COOLDOWN" -v thr="$THRESHOLD" -v mode="$RING" \
                -v halted="$halted" -v now="$now" -v sts="${shown_ts:-0}" -v rts="$rts" '
      BEGIN {
        d = c - l; if (d < 0) d = 0
        p += d; a += d
        acc = a + ga             # everything the ear has not announced, wherever it was held
        carry = 0
        pulse = (p >= min && now - sts >= cd)
        # What survives a ring. A threshold keeps its remainder: the crossing
        # rarely lands on the number exactly, and zeroing what is left over
        # would drop a fraction of a ring every time and drift quieter than the
        # threshold asked for. The other two modes have announced everything.
        if      (mode == "cumulative_threshold") { ring = (acc >= thr); if (ring) carry = acc % thr }
        else if (mode == "on_halt")                ring = (halted && acc >= min)
        else                                       ring = (acc >= min && now - rts >= cd)
        printf "%.6f %.6f %.6f %d %d %.6f %.6f", d, p, acc, pulse, ring, carry, a
      }')
    IFS=' ' read -r bump pending ring_acc pulse ring carry deferred <<< "$money"

    if [ "$bump" != "0.000000" ]; then
      last_call=$now
      record_sample "$bump" "$used" "$cwrite" "$cread" "$tag-${session:-nosession}" "$ratefile"
    fi

    if [ "$pulse" = 1 ]; then shown=$pending; shown_ts=$now; pending=0; fi

    if [ -z "$gring" ]; then
      if [ "$ring" = 1 ]; then ring_ts=$now; ring_acc=$carry; fi
    elif [ "$locked" = 1 ]; then
      # Everything this session was carrying has now been handed over, so its
      # own accumulator goes back to empty.
      if [ "$ring" = 1 ]; then gts=$now; gacc=$carry; else gacc=$ring_acc; fi
      ring_acc=0
      printf '%s %s\n' "$gts" "$gacc" > "$gring.tmp" 2>/dev/null &&
        mv -f "$gring.tmp" "$gring" 2>/dev/null || true
      rm -f "$gring.lock" 2>/dev/null || true
      [ "$halted" = 1 ] && { rm -f "$halt" 2>/dev/null || true; }
    else
      # Another session holds it. Keep this session's own money where it is and
      # come back on the next render — a ring deferred by a second is still the
      # ring, money dropped on the floor is a bug.
      ring=0
      ring_acc=$deferred
    fi
  fi

  # prompt_id changing means a new prompt started. Sampling no longer waits for
  # that — it happens on every request — so this boundary now only paces the
  # once-per-turn TTL read.
  if [ "$prompt" != "$prev_prompt" ]; then
    prev_prompt=$prompt
    turn_cost=$cost
    turn_ctx=$used
    # Which TTL this session is on decides when the window goes cold, and only
    # the transcript names it. Read once per turn, never per render.
    [ -n "${transcript:-}" ] && ttl=$(detect_ttl "$transcript" || printf '%s' "${ttl:-0}")
  fi

  printf '%s %s %s %s %s %s %s %s %s %s %s %s\n' "$cost" "$pending" "$ring_ts" "$shown" "$shown_ts" \
    "$prev_prompt" "${turn_cost:-$cost}" "${turn_ctx:-$used}" "${last_call:-0}" "${ttl:-0}" \
    "${ring_acc:-0}" "${woffset:-0}" \
    > "$state.tmp" 2>/dev/null && mv -f "$state.tmp" "$state" 2>/dev/null || true

  # Context, parked where the band hook can read it.
  printf '%s %s\n' "$used" "$size" > "$RUN/$tag-${session:-nosession}.ctx" 2>/dev/null || true

  [ "$ring" = 1 ] && play_sound

  local segment="" chain=""
  if [ "${RTC_SEGMENT:-1}" != "0" ]; then
    # A render is three processes and the statusline re-runs every second for
    # every open session — measured at 38% of a core across two dozen of them.
    # Most of those renders have nothing new to say, so the line is cached and
    # only rebuilt when something it depends on moves. A fade in progress
    # changes the line every frame and is never cached.
    local cache key fading=0 age fade_int=${FADE%.*} minute=0
    cache="$RUN/$tag-${session:-nosession}.line"
    # The cache clock moves on its own, so the key carries a minute counter —
    # otherwise a window could go cold behind a cached line that still claims it
    # is warm. One extra render a minute, not one a second.
    [ "${ttl:-0}" != "0" ] && [ "${last_call%.*}" != "0" ] &&
      minute=$(( ( ${now%.*} - ${last_call%.*} ) / 60 ))
    key="$used|$size|$cost|$prompt|$minute|$noprice"

    if [ "${shown_ts%.*}" != "0" ]; then
      age=$(( ${now%.*} - ${shown_ts%.*} ))
      [ "$age" -le "$((fade_int + 1))" ] && fading=1
    fi

    if [ "$fading" = 0 ] && [ -r "$cache" ]; then
      local cached_key cached_line
      { read -r cached_key; read -r cached_line; } < "$cache" 2>/dev/null
      [ "${cached_key:-}" = "$key" ] && segment=$cached_line
    fi

    if [ -z "$segment" ]; then
      local est="" disp_cost="$cost" disp_shown="$shown"
      # A Kimi model with no rate shows the gauge and nothing about money —
      # half a money display is worse than none. doctor says how to fix it.
      if [ "$noprice" = 1 ]; then disp_cost=-1; disp_shown=0;
      elif [ "$ESTIMATE" != "0" ]; then
        est=$(estimate "$tag-${session:-nosession}" "$used" "${last_call:-0}" "${ttl:-0}" "$now" "$ratefile" 2>/dev/null)
      fi
      segment=$(render "$model" "$effort" "$used" "$size" "$disp_cost" "$disp_shown" "$shown_ts" "$now" "${est:-}")
      [ "$fading" = 0 ] && {
        printf '%s\n%s\n' "$key" "$segment" > "$cache.tmp" 2>/dev/null &&
          mv -f "$cache.tmp" "$cache" 2>/dev/null || true
      }
    fi
  fi

  if [ -n "${RTC_CHAIN:-}" ]; then
    chain=$(printf '%s' "$payload" | eval "${RTC_CHAIN}" 2>/dev/null)
  fi

  if [ -n "$segment" ] && [ -n "$chain" ]; then
    printf '%s  %s' "$segment" "$chain"
  else
    printf '%s%s' "$segment" "$chain"
  fi
}

# What the next message will cost, learned from this session rather than from a
# price table that would go stale the day rates move.
#
# The dominant term is re-reading the context you already have, which scales with
# window size — so what carries between turns is the ratio, dollars per million
# tokens of context, not the dollar figure itself. Median rather than mean: one
# turn that read forty files should not set the expectation for the next.
# Which prompt-cache TTL this session is on. The statusline payload gives only a
# flat cache_creation figure, but the transcript breaks it out by TTL, so the
# answer is read from there — once per turn, never per render.
detect_ttl() {
  local t="$1" line
  [ -r "$t" ] || return 1
  if command -v tac >/dev/null 2>&1; then
    line=$(tac "$t" 2>/dev/null | grep -m1 'ephemeral_1h_input_tokens')
  else
    line=$(tail -r "$t" 2>/dev/null | grep -m1 'ephemeral_1h_input_tokens')
  fi
  [ -n "$line" ] || return 1
  printf '%s' "$line" | jq -r '
    (.message.usage.cache_creation // {}) as $c
    | if   ($c.ephemeral_1h_input_tokens // 0) > 0 then 3600
      elif ($c.ephemeral_5m_input_tokens // 0) > 0 then 300
      else empty end' 2>/dev/null
}

# Emits "<dollars> <state> <seconds_left> <samples>" — the bare cost of
# submitting this context, and how long that price holds.
#
# What the turn then does is not estimable: whether Claude answers in one word or
# makes twenty tool calls is a property of the work, not of the context. But
# submission itself is fixed the moment you press enter, and its price has two
# values, not one. A cached window is re-READ at the cache-read rate. An expired
# one is re-WRITTEN, twenty times dearer on the 1-hour TTL, and which of the two
# you get is knowable: the clock started when the last request completed.
#
# Warm cost comes from the cheapest ordinary turn — one API call, a submit plus a
# few tokens of reply. Cold cost comes from an observed rebuild if this session
# has suffered one, and otherwise from the write/read price ratio.
estimate() {
  local sess="$1" ctx="$2" last_call="$3" ttl="$4" now="$5" ratefile="$6"
  local turns="$RUN/$sess.turns" cold="$RUN/$sess.rebuilds"
  # This session's own turns are the better evidence. Fall back to what this
  # model has taught us before, so a fresh session is not blind.
  [ -r "$turns" ] || turns="$ratefile"
  [ -r "$turns" ] || return 1
  [ "${ctx:-0}" -gt 0 ] || return 1
  awk -v ctx="$ctx" -v coldf="$cold" -v lc="$last_call" -v ttl="$ttl" -v now="$now" '
    { if (n == 0 || $1 + 0 < lo) lo = $1 + 0; n++ }
    END {
      if (n < 1 || lo <= 0) exit 1
      warm = lo * (ctx / 1000000)

      # A measured rebuild beats an asserted ratio. Fall back to write/read only
      # when this session has not yet paid for one.
      cr = 0
      while ((getline v < coldf) > 0) if (cr == 0 || v + 0 < cr) cr = v + 0
      close(coldf)
      cold = (cr > 0) ? cr * (ctx / 1000000) : warm * (ttl >= 3600 ? 20 : 12.5)

      if (lc + 0 <= 0 || ttl + 0 <= 0) { printf "%.2f warm 0 %d", warm, n; exit }

      left = ttl - (now - lc)
      if      (left <= 0)  printf "%.2f cold 0 %d", cold, n
      else if (left < 300) printf "%.2f expiring %d %d", warm, left, n
      else                 printf "%.2f warm %d %d", warm, left, n
    }' "$turns"
}

render() {
  awk -v model="$1" -v effort="$2" -v used="$3" -v size="$4" -v cost="$5" \
      -v delta="$6" -v dts="$7" -v now="$8" -v est="$9" -v fade="$FADE" '
  function scale(n) { return n >= 1000000 ? sprintf("%.2fM", n/1000000) : sprintf("%.0fk", n/1000) }
  function rgb(r, g, b) { return sprintf("\033[38;2;%d;%d;%dm", r, g, b) }
  BEGIN {
    RESET = "\033[0m"; DIM = "\033[2m"
    out = DIM model RESET
    if (effort != "-" && effort != "null" && effort != "") out = out " " DIM effort RESET

    if (size > 0) {
      pct = used / size * 100
      filled = int(pct / 10); if (filled > 10) filled = 10
      bar = ""
      for (i = 0; i < 10; i++) bar = bar (i < filled ? "█" : "░")

      # Truncate, never round. The figure must not overstate, and must agree
      # with the bar sitting next to it.
      shown = pct < 10 ? sprintf("%.1f", int(pct*10)/10) : sprintf("%d", int(pct))
      colour = pct >= 80 ? rgb(248,113,113) : (pct >= 50 ? rgb(251,191,36) : rgb(74,222,128))
      out = out " " colour bar " " shown "%" RESET
      out = out " " DIM scale(used) " / " scale(size) RESET
    }
    # A negative cost is the noprice signal (Kimi model with no rate): the
    # gauge renders, everything about money stays out.
    if (cost + 0 >= 0) out = out sprintf(" %s$%.2f%s", DIM, cost, RESET)

    # What the next message is likely to cost, before it is sent. Dim while a
    # single turn is carrying the whole guess; full blue once the median has
    # enough behind it to survive one unusual turn.
    # Blue while the window is cached, amber as the clock runs down with the
    # minutes left, red once it has lapsed — where the figure is no longer a
    # re-read but a full rewrite, and the arrow says so.
    if (est != "") {
      split(est, e, " ")
      young = (e[4] + 0 < 3) ? DIM : ""
      if (e[2] == "cold")
        out = out sprintf(" %s%s[~$%s ⟳]%s", young, rgb(248,113,113), e[1], RESET)
      else if (e[2] == "expiring")
        out = out sprintf(" %s%s[~$%s · %dm]%s", young, rgb(251,191,36), e[1], int(e[3] / 60) + 1, RESET)
      else
        out = out sprintf(" %s%s[~$%s]%s", young, rgb(96,165,250), e[1], RESET)
    }

    # The floating number. Age drives it, so a render landing at any moment gets
    # the right colour rather than a fixed frame.
    age = now - dts
    if (cost + 0 >= 0 && dts > 0 && delta > 0 && age < fade) {
      t = age / fade
      k = t < 0.15 ? 0 : (t - 0.15) / 0.85     # holds bright for a beat, then falls
      bold = t < 0.15 ? "\033[1m" : ""
      out = out sprintf("  %s%s+$%.2f%s", bold, rgb(134 + (26-134)*k, 239 + (48-239)*k, 172 + (36-172)*k), delta, RESET)
    }
    printf "%s", out
  }'
}

play_sound() {
  [ "${RTC_MUTE:-0}" = "1" ] && return 0
  local wav p
  wav=${RTC_SOUND:-$ROOT/share/cash-register.wav}
  [ -s "$wav" ] || return 0
  for p in pw-play paplay aplay afplay; do
    if command -v "$p" >/dev/null 2>&1; then
      # Detached, so a wedged audio server never stalls a render.
      (setsid "$p" "$wav" >/dev/null 2>&1 &) 2>/dev/null
      return 0
    fi
  done
}

# ── context band hook ─────────────────────────────────────────────────────────
cmd_hook() {
  local payload platform tag session ctx used size band last state
  payload=$(cat)
  # Kimi hook payloads name their event; Claude ones do not. Both carry
  # session_id. Only the reply format differs: Kimi appends stdout to the
  # context as plain text, Claude wants a systemMessage JSON object.
  platform=$(printf '%s' "$payload" | jq -r 'if .hook_event_name != null then "kimi" else "claude" end' 2>/dev/null)
  session=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
  [ -n "$session" ] || exit 0
  tag=rtc
  [ "$platform" = kimi ] && tag=rtc-kimi

  ctx="$RUN/$tag-${session}.ctx"
  if [ ! -r "$ctx" ]; then
    # Installed but never set up. The hooks wire themselves and the statusline
    # cannot, so this is the one failure mode a new user will actually hit —
    # say it once rather than sitting there silently doing nothing.
    local nudge="$RUN/$tag-${session}.nudged" wired=1
    if [ "$platform" = kimi ]; then
      grep -q 'bin/rtc' "$KIMI_TUI" 2>/dev/null || wired=0
    else
      jq -e '.statusLine.command // "" | test("realtokencost")' "$SETTINGS" >/dev/null 2>&1 || wired=0
    fi
    if [ "$wired" = 0 ] && [ ! -e "$nudge" ]; then
      : > "$nudge" 2>/dev/null || true
      if [ "$platform" = kimi ]; then
        printf 'realtokencost is installed but not wired to the status line, which is the only place Kimi Code exposes context. Run /realtokencost:setup\n'
      else
        jq -n '{systemMessage: "realtokencost is installed but not wired to the statusline, which is the only place Claude Code exposes cost and context. Run /realtokencost:setup"}'
      fi
    fi
    exit 0
  fi
  IFS=' ' read -r used size < "$ctx" 2>/dev/null
  case "${used:-}${size:-}" in ''|*[!0-9]*) exit 0 ;; esac
  [ "${size:-0}" -gt 0 ] || exit 0

  band=$(( used * 100 / size / BANDS ))
  [ "$band" -ge 1 ] || exit 0

  state="$RUN/$tag-${session}.band"
  last=0
  [ -r "$state" ] && last=$(cat "$state" 2>/dev/null)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ "$band" -gt "$last" ] || exit 0             # once per band, on the way up
  printf '%s' "$band" > "$state" 2>/dev/null || true

  # Report where the window actually is. The band is only what triggered this —
  # saying "40%" while the window sits at 45% disagrees with the statusline for
  # no reason, and the statusline is right.
  local msg="context $(awk -v u="$used" -v s="$size" 'BEGIN { printf "%d", u * 100 / s }')% used — $(human "$used") of $(human "$size") tokens"
  if [ "$platform" = kimi ]; then
    printf '%s\n' "$msg"
  else
    jq -n --arg m "$msg" '{systemMessage: $m}'
  fi
}

human() { awk -v n="$1" 'BEGIN { printf (n >= 1000000 ? "%.2fM" : "%.0fk"), n / (n >= 1000000 ? 1000000 : 1000) }'; }

# ── halt marker ───────────────────────────────────────────────────────────────
# Stop and Notification are the two moments a turn hands control back: work
# submitted, a question asked, permission wanted.
#
# This drops a marker rather than ringing, and the difference matters. A hook
# payload carries no cost — none of them do — so the money would have to come
# from the state file, and at the instant Stop fires the statusline has not yet
# been re-run with the final request's cost in it. On a one-request turn that
# request is the entire spend, and the ring would announce nothing at all. So
# leave a mark and let the statusline ring on its next render, with the real
# number in hand. Idle sessions keep rendering on the refreshInterval timer —
# checked across two dozen of them at once, every state file had been rewritten
# within the last second while the cached lines beside them were minutes old —
# so a marker is never left sitting for longer than that.
cmd_halt() {
  [ "$RING" = on_halt ] || exit 0
  local payload platform session tag
  payload=$(cat)
  IFS=$'\t' read -r platform session < <(
    printf '%s' "$payload" | jq -r '[(if .hook_event_name != null then "kimi" else "claude" end), (.session_id // "")] | @tsv' 2>/dev/null
  )
  [ -n "$session" ] || exit 0
  tag=rtc
  [ "$platform" = kimi ] && tag=rtc-kimi
  : > "$RUN/$tag-$session.halt" 2>/dev/null || true
}

# ── setup ─────────────────────────────────────────────────────────────────────
# Setup is per platform, one config file between them. Each platform wires its
# own native slot: Claude's settings.json statusLine, Kimi's tui.toml
# [status_line].command plus hooks in config.toml (unless running from a Kimi
# plugin managed copy, whose manifest already declares them).
cmd_setup() {
  command -v jq >/dev/null 2>&1 || die "realtokencost needs jq."
  local did=0
  if [ -f "$SETTINGS" ]; then setup_claude; did=1; fi
  if [ -d "$KIMI_HOME" ]; then setup_kimi; did=1; fi
  [ "$did" = 1 ] || die "found neither $SETTINGS nor $KIMI_HOME — is Claude Code or Kimi Code installed?"
}

# Never chain to ourselves, under any name we have ever had. Re-running setup,
# moving from a checkout to an installed copy, or renaming the project would
# otherwise wire this into its own chain and render the gauge twice, with the
# two copies fighting over one state file. The rename to realtokencost proved
# the point: a guard that knew only the current name promptly chained the
# abandoned cha-ching binary, which was still sitting in the plugin cache.
chain_maybe() {
  local current="$1"
  [ -n "$current" ] && [ "$current" != "$SELF" ] || return 0
  printf '%s' "$current" | grep -qE 'realtokencost|cha-ching|/rtc([[:space:]]|$)' && return 0
  mkdir -p "$CONFIG_DIR"
  if grep -q '^RTC_CHAIN=' "$CONFIG" 2>/dev/null; then
    printf '  keeping the chain already in %s\n' "$CONFIG"
  else
    printf 'RTC_CHAIN=%s\n' "$current" >> "$CONFIG"
    printf '  chaining to your existing statusline: %s\n' "$current"
  fi
}

setup_claude() {
  printf 'claude: %s\n' "$SETTINGS"
  local current backup tmp
  current=$(jq -r '.statusLine.command // empty' "$SETTINGS")
  chain_maybe "$current"

  backup="$SETTINGS.realtokencost.bak"
  cp "$SETTINGS" "$backup"
  tmp=$(mktemp)
  jq --arg cmd "$SELF" \
     '.statusLine = {"type":"command","command":$cmd,"refreshInterval":1}' \
     "$SETTINGS" > "$tmp" && jq empty "$tmp" && mv "$tmp" "$SETTINGS" \
    || die "failed to write $SETTINGS (backup at $backup)"

  printf '  statusLine claimed. Backup at %s\n' "$backup"
  printf '  restart Claude Code — statusLine is read at startup.\n'
}

# The first command = line inside the [status_line] section, unquoted.
kimi_tui_command() {
  [ -f "$KIMI_TUI" ] || return 1
  awk '
    /^\[status_line\][[:space:]]*$/ { insl=1; next }
    /^\[/ { insl=0 }
    insl && /^[[:space:]]*command[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit
    }' "$KIMI_TUI"
}

# Write [status_line].command into tui.toml without disturbing anything else:
# replace an existing command line, insert into an existing section, or append
# the section. tui.toml is small and user-owned, so back it up first.
kimi_write_tui() {
  local backup tmp
  backup="$KIMI_TUI.realtokencost.bak"
  [ -f "$KIMI_TUI" ] && cp "$KIMI_TUI" "$backup"
  tmp=$(mktemp)
  if [ ! -f "$KIMI_TUI" ]; then
    printf '[status_line]\ncommand = "%s"\n' "$SELF" > "$tmp" || return 1
  else
    awk -v cmd="$SELF" '
      /^\[status_line\][[:space:]]*$/ { insl=1; seen=1; print; next }
      /^\[/ {
        if (insl && !done) print "command = \"" cmd "\""
        insl=0; done=0; print; next
      }
      insl && /^[[:space:]]*command[[:space:]]*=/ {
        if (!done) { print "command = \"" cmd "\""; done=1 }
        next
      }
      { print }
      END {
        if (insl && !done) print "command = \"" cmd "\""
        if (!seen) { print ""; print "[status_line]"; print "command = \"" cmd "\"" }
      }' "$KIMI_TUI" > "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  [ -s "$tmp" ] && mv "$tmp" "$KIMI_TUI" || { rm -f "$tmp"; return 1; }
}

setup_kimi() {
  printf 'kimi: %s\n' "$KIMI_HOME"

  local current
  current=$(kimi_tui_command)
  chain_maybe "$current"
  kimi_write_tui || die "failed to write $KIMI_TUI"
  printf '  status_line claimed in tui.toml%s\n' "$([ -f "$KIMI_TUI.realtokencost.bak" ] && printf ' (backup alongside)')"

  # Hooks. A Kimi plugin managed copy declares them in kimi.plugin.json; a
  # plain checkout needs them appended to config.toml, marked so uninstall can
  # find the block again.
  case "$SELF" in
    "$KIMI_HOME"/plugins/managed/*)
      printf '  hooks: from the plugin manifest — nothing to write\n' ;;
    *)
      if grep -q 'bin/rtc' "$KIMI_CONF" 2>/dev/null; then
        printf '  hooks: already wired in config.toml\n'
      else
        [ -f "$KIMI_CONF" ] && cp "$KIMI_CONF" "$KIMI_CONF.realtokencost.bak"
        cat >> "$KIMI_CONF" <<EOF

# >>> realtokencost — rtc uninstall removes this block
[[hooks]]
event = "UserPromptSubmit"
command = "$SELF hook"

[[hooks]]
event = "Stop"
command = "$SELF halt"

[[hooks]]
event = "Notification"
command = "$SELF halt"
# <<< realtokencost
EOF
        printf '  hooks: appended to config.toml (backup alongside)\n'
      fi ;;
  esac

  printf '  run /reload-tui (or restart Kimi Code) to pick up the status line.\n'
  cmd_rates || true
}

# Kimi reports usage, never dollars — the money features price measured tokens
# from these rates, so there is nothing to show without them. An
# RTC_PRICE_<model> config line always wins; this command is the other source:
# what models.dev publishes for the models in config.toml, cached per model.
# Nothing is guessed: an unmatched model gets instructions, not a number.
cmd_rates() {
  [ -f "$KIMI_CONF" ] || { printf 'rates: no %s — nothing to price\n' "$KIMI_CONF"; return 1; }
  command -v curl >/dev/null 2>&1 || { printf 'rates: needs curl\n'; return 1; }
  command -v jq >/dev/null 2>&1 || die "realtokencost needs jq."

  local pairs api
  # "alias<TAB>model id" for every [models.*] table
  pairs=$(awk '
    /^\[models\./ {
      hdr=$0; sub(/^\[models\./, "", hdr); sub(/\][[:space:]]*$/, "", hdr)
      sub(/\.overrides$/, "", hdr); gsub(/"/, "", hdr); alias=hdr; inm=1; next
    }
    /^\[/ { inm=0 }
    inm && /^[[:space:]]*model[[:space:]]*=/ {
      v=$0; sub(/^[^=]*=[[:space:]]*/, "", v); gsub(/"/, "", v)
      print alias "\t" v
    }' "$KIMI_CONF")
  [ -n "$pairs" ] || { printf 'rates: no [models.*] tables in %s\n' "$KIMI_CONF"; return 1; }

  printf 'rates: fetching models.dev…\n'
  api=$(curl -fsSL --max-time 30 https://models.dev/api.json 2>/dev/null) || {
    printf 'rates: fetch failed — set prices by hand instead, e.g.\n'
    printf '  RTC_PRICE_kimi_code_k3="2.0 0.20 2.5 8.0"   (input cache_read cache_write output, $/M) in %s\n' "$CONFIG"
    return 1
  }
  printf '%s' "$api" | jq empty 2>/dev/null || { printf 'rates: models.dev returned unparseable JSON — nothing written\n'; return 1; }

  local alias mid san key provider input output cr cw hits line
  printf '%s\n' "$pairs" | while IFS=$'\t' read -r alias mid; do
    [ -n "$mid" ] || continue
    san=$(printf '%s' "$alias" | tr -c 'A-Za-z0-9._-' '_')
    hits=$(printf '%s' "$api" | jq -r --arg m "$mid" '
      to_entries[] | .key as $p | (.value.models // {}) | to_entries[] |
      select(.key == $m or .key == ("kimi-" + $m)) |
      [$p, .key, (.value.cost.input // ""), (.value.cost.output // ""),
       (.value.cost.cache_read // ""), (.value.cost.cache_write // "")] | @tsv')
    if [ -z "$hits" ]; then
      printf '  %-28s no models.dev match for "%s" — set RTC_PRICE_%s="input cache_read cache_write output" in %s\n' \
        "$alias" "$mid" "$(printf '%s' "$san" | tr -c 'A-Za-z0-9_' '_')" "$CONFIG"
      continue
    fi
    # A model id like kimi-k3 is carried by two dozen gateways, and the first
    # one in the file is not the number a "what would this cost on the API"
    # question asks for. Prefer the first-party provider, then any entry that
    # publishes a non-zero price — a subscription plan lists $0, which answers
    # a different question.
    local nhits
    nhits=$(printf '%s\n' "$hits" | wc -l); nhits=$((nhits))
    line=$(printf '%s\n' "$hits" | awk -F'\t' '$1 == "moonshotai" { print; exit }')
    [ -n "$line" ] || line=$(printf '%s\n' "$hits" | awk -F'\t' '$1 == "moonshotai-cn" { print; exit }')
    [ -n "$line" ] || line=$(printf '%s\n' "$hits" | awk -F'\t' '$3 + 0 > 0 { print; exit }')
    [ -n "$line" ] || line=$(printf '%s\n' "$hits" | head -1)
    IFS=$'\t' read -r provider key input output cr cw <<< "$line"
    if [ "$(awk -v a="${input:-0}" -v b="${output:-0}" 'BEGIN { print (a + b > 0) ? 1 : 0 }')" = 0 ]; then
      printf '  %-28s only %s publishes %s, at $0 — a subscription plan, not an API price.\n' "$alias" "$provider" "$key"
      printf '  %-28s set RTC_PRICE_%s="input cache_read cache_write output" in %s\n' \
        "" "$(printf '%s' "$san" | tr -c 'A-Za-z0-9_' '_')" "$CONFIG"
      continue
    fi
    # A cache rate nobody publishes is not a reason to stay silent — the plain
    # input rate is the honest floor, and the file says which fields fell back.
    local note=""
    [ -n "$cr" ] || { cr=$input; note="$note cache_read=input"; }
    [ -n "$cw" ] || { cw=$input; note="$note cache_write=input"; }
    mkdir -p "$CACHE_DIR"
    # Atomic: a render can read this file at any moment, including mid-refresh.
    printf '%s %s %s %s models.dev:%s/%s %s%s\n' "$input" "$cr" "$cw" "$output" \
      "$provider" "$key" "$(date +%F)" "$note" > "$CACHE_DIR/price-$san.tmp" 2>/dev/null &&
      mv -f "$CACHE_DIR/price-$san.tmp" "$CACHE_DIR/price-$san" 2>/dev/null || rm -f "$CACHE_DIR/price-$san.tmp"
    printf '  %-28s %s/%s — in $%s read $%s write $%s out $%s /M%s%s\n' \
      "$alias" "$provider" "$key" "$input" "$cr" "$cw" "$output" "$note" \
      "$([ "$nhits" -gt 1 ] && printf ' (of %s candidates)' "$nhits")"
  done
  : > "$CACHE_DIR/.rates-when" 2>/dev/null || true
}

cmd_uninstall() {
  local chain tmp
  chain=$(sed -n 's/^RTC_CHAIN=//p' "$CONFIG" 2>/dev/null | head -1)

  if [ -f "$SETTINGS" ]; then
    tmp=$(mktemp)
    if [ -n "$chain" ]; then
      jq --arg cmd "$chain" '.statusLine = {"type":"command","command":$cmd}' "$SETTINGS" > "$tmp"
      printf 'claude: restored your statusline: %s\n' "$chain"
    else
      jq 'del(.statusLine)' "$SETTINGS" > "$tmp"
      printf 'claude: removed the statusline entry.\n'
    fi
    jq empty "$tmp" && mv "$tmp" "$SETTINGS" || die "failed to write $SETTINGS"
  fi

  if [ -f "$KIMI_TUI" ]; then
    tmp=$(mktemp)
    # Remove our command line (putting back the chain, if there is one), drop
    # the marked hooks block, leave everything else alone.
    awk -v chain="$chain" '
      /^\[status_line\][[:space:]]*$/ { insl=1; print; next }
      /^\[/ { insl=0; print; next }
      insl && /^[[:space:]]*command[[:space:]]*=/ {
        if ($0 ~ /bin\/rtc/) {
          if (chain != "") print "command = \"" chain "\""
          next
        }
        print; next
      }
      { print }' "$KIMI_TUI" > "$tmp" && [ -s "$tmp" ] && mv "$tmp" "$KIMI_TUI" || rm -f "$tmp"
    printf 'kimi: status_line handed back%s\n' "$([ -n "$chain" ] && printf ' (chained to %s)' "$chain")"
  fi
  if grep -q '^# >>> realtokencost' "$KIMI_CONF" 2>/dev/null; then
    tmp=$(mktemp)
    awk '/^# >>> realtokencost/ { skip=1; next }
         /^# <<< realtokencost/ { skip=0; next }
         !skip { print }' "$KIMI_CONF" > "$tmp" && mv "$tmp" "$KIMI_CONF"
    printf 'kimi: hooks block removed from config.toml\n'
  fi
  printf 'Config left at %s — delete it if you are done.\n' "$CONFIG"
}

# ── doctor ────────────────────────────────────────────────────────────────────
# Which sessions are actually open. Nothing deletes a state file — it lives
# until $XDG_RUNTIME_DIR is cleared at logout — so counting the files counts
# every session this machine has run since then, and doctor was reporting a
# third of a core against three live sessions and two dozen dead ones. A live
# session rewrites its state on every render, so recency is what live means.
# `-mmin` rather than `-newermt`: both GNU and BSD find have it, and the minute
# is generous against a one-second refreshInterval.
live_states() { find "$RUN" -maxdepth 1 -name 'rtc-*.state' -mmin -1 2>/dev/null; }

cmd_doctor() {
  local ok stale p found wired
  printf 'rtc doctor\n\n'

  if command -v jq >/dev/null 2>&1; then printf '  jq          %s\n' "$(command -v jq)"
  else printf '  jq          MISSING — nothing works without it\n'; fi

  found=""
  for p in pw-play paplay aplay afplay; do
    command -v "$p" >/dev/null 2>&1 && { found=$p; break; }
  done
  if [ -n "$found" ]; then printf '  player      %s\n' "$found"
  else printf '  player      none of pw-play/paplay/aplay/afplay — it will be silent\n'; fi

  if [ -s "$ROOT/share/cash-register.wav" ]; then printf '  sound       %s\n' "$ROOT/share/cash-register.wav"
  else printf '  sound       MISSING at %s\n' "$ROOT/share/cash-register.wav"; fi

  if [ "${RTC_MUTE:-0}" = "1" ]; then
    printf '  ring        muted by RTC_MUTE=1 — the number still floats\n'
  else
    case "$RING" in
      immediate)
        printf '  ring        immediate — every bump over $%s, at most one per %ss\n' "$MIN" "$COOLDOWN" ;;
      cumulative_threshold)
        printf '  ring        cumulative_threshold — once per $%s spent\n' "$THRESHOLD" ;;
      on_halt)
        printf '  ring        on_halt — when a turn hands back, if money moved since the last one\n'
        if grep -q '"Stop"' "$ROOT/hooks/hooks.json" 2>/dev/null; then
          printf '              marked by the Stop hook; if you upgraded mid-session, restart to load it\n'
        else
          printf '              but %s has no Stop hook, so nothing will mark a halt\n' "$ROOT/hooks/hooks.json"
        fi ;;
      *)
        printf '  ring        RTC_RING=%s is not a mode — ringing immediately instead\n' "$RING"
        printf '              modes: immediate, cumulative_threshold, on_halt\n' ;;
    esac

    # A shared ring is a session going quiet because another one spoke for it,
    # which looks exactly like a broken ring from inside any one session.
    if [ "$SCOPE" = session ]; then
      printf '  ring scope  session — each session counts and announces its own spend\n'
    else
      local gring gts gacc lock_ts
      gring="$RUN/rtc-global-${UID:-0}.ring"
      read_ring "$gring"
      if [ "$SCOPE" = global ]; then
        printf '  ring scope  global — one ring for every session on this machine\n'
      else
        printf '  ring scope  RTC_RING_SCOPE=%s is not a scope — sharing globally instead\n' "$SCOPE"
        printf '              scopes: session, global\n'
      fi
      printf '              %s\n' "$gring"
      awk -v a="$gacc" -v t="$gts" -v n="$(now_s)" 'BEGIN {
        printf "              $%.2f carried, last ring ", a
        if (t > 0) printf "%ds ago\n", n - t; else printf "none yet\n" }'
      if [ -e "$gring.lock" ]; then
        lock_ts=0; read -r lock_ts < "$gring.lock" 2>/dev/null
        printf '              lock held %ss — over 5s means a session died holding it, and the\n' \
          "$(awk -v t="${lock_ts:-0}" -v n="$(now_s)" 'BEGIN { printf "%d", n - t }')"
        printf '              next session to want it takes it back\n'
      fi
    fi
  fi

  wired=$(jq -r '.statusLine.command // "none"' "$SETTINGS" 2>/dev/null)
  if [ "$wired" = "$SELF" ]; then
    printf '  statusLine  wired (refreshInterval %s)\n' "$(jq -r '.statusLine.refreshInterval // "unset"' "$SETTINGS")"
  else
    printf '  statusLine  NOT wired — currently %s\n' "$wired"
    printf '              run: rtc setup\n'
  fi

  if [ -d "$KIMI_HOME" ]; then
    local kwired
    kwired=$(kimi_tui_command)
    if [ "$kwired" = "$SELF" ]; then
      printf '  kimi line   wired in %s\n' "$KIMI_TUI"
    else
      printf '  kimi line   NOT wired — currently %s\n' "${kwired:-none}"
      printf '              run: rtc setup\n'
    fi
    case "$SELF" in
      "$KIMI_HOME"/plugins/managed/*)
        printf '  kimi hooks  from the plugin manifest\n' ;;
      *)
        if grep -q 'bin/rtc' "$KIMI_CONF" 2>/dev/null; then
          printf '  kimi hooks  wired in config.toml\n'
        else
          printf '  kimi hooks  MISSING — band warnings and halt rings will not fire\n'
          printf '              run: rtc setup\n'
        fi ;;
    esac

    # Money under Kimi is measured tokens times a rate, so a model with no rate
    # is a silent money display — say where every known rate came from and
    # which live model has none.
    local kc
    for kc in $(grep -s '^RTC_PRICE_' "$CONFIG" | cut -d= -f1); do
      printf '  kimi price  %s — config override in %s\n' "${kc#RTC_PRICE_}" "$CONFIG"
    done
    local pf pm
    for pf in "$CACHE_DIR"/price-*; do
      [ -r "$pf" ] || continue
      pm=$(stat -c %Y "$pf" 2>/dev/null || stat -f %m "$pf" 2>/dev/null || printf '0')
      printf '  kimi price  %s — %s\n' "${pf##*/price-}" "$(cut -d' ' -f5- < "$pf")"
      awk -v m="${pm:-0}" -v n="$(now_s)" -v max="${RTC_RATES_MAX_AGE_DAYS:-30}" 'BEGIN {
        d = (n - m) / 86400
        printf "              cache %d day(s) old%s\n", d,
          (d > max) ? " — stale, a detached refresh fires on the next render" : "" }'
    done
    local sf ksess kalias kmid
    while read -r sf; do
      case "$sf" in */rtc-kimi-*) ;; *) continue ;; esac
      ksess=${sf##*/rtc-kimi-}; ksess=${ksess%.state}
      kalias=""
      [ -r "$RUN/rtc-kimi-$ksess.wire" ] && { read -r _; read -r kalias; } < "$RUN/rtc-kimi-$ksess.wire" 2>/dev/null
      if [ -z "$kalias" ]; then
        printf '  kimi wire   %.8s — no usage rows seen yet (money starts with the first request)\n' "$ksess"
        continue
      fi
      kmid=$(printf '%s' "$kalias" | tr -c 'A-Za-z0-9._-' '_')
      if ! price_for "$kmid"; then
        printf '  kimi price  %s — NO RATE, money features are off for this model\n' "$kalias"
        printf '              fix: rtc rates, or RTC_PRICE_%s="input cache_read cache_write output" in %s\n' \
          "$(printf '%s' "$kmid" | tr -c 'A-Za-z0-9_' '_')" "$CONFIG"
      elif [ "$PRICE_SRC" = seed ]; then
        printf '  kimi price  %s — bundled seed (see share/prices.tsv for its date); the cache\n' "$kalias"
        printf '              freshens itself on render, or run: rtc rates\n'
      fi
    done < <(live_states)
    # Kimi publishes no cache TTL, so the estimate there never carries the
    # expiring/cold countdown — it shows the warm figure only. Say so once,
    # here, rather than letting the missing bracket look like a bug.
    printf '  kimi ttl    unpublished — estimates show the warm price, no expiry countdown\n'
  fi

  [ -n "${RTC_CHAIN:-}" ] && printf '  chain       %s\n' "$RTC_CHAIN"

  ok=$(live_states | wc -l); ok=$((ok))
  stale=$(ls "$RUN"/rtc-*.state 2>/dev/null | wc -l); stale=$(( stale - ok ))
  printf '  live data   %s session(s) rendering now\n' "$ok"
  if [ "$stale" -gt 0 ]; then
    printf '              %s state file(s) left behind by sessions that have ended. They cost\n' "$stale"
    printf '              nothing and go at logout with %s; to clear them now:\n' "$RUN"
    printf '                find %s -maxdepth 1 -name '\''rtc-*'\'' ! -name '\''*.ring'\'' -mmin +60 -delete\n' "$RUN"
  fi

  # refreshInterval 1 re-runs this for every open session, every second. That is
  # cheap once and not cheap two dozen times, so show the arithmetic — over the
  # sessions actually rendering, which is the whole reason the count above is
  # measured rather than globbed.
  if [ "$ok" -gt 0 ]; then
    printf '  render cost ~%dms each; %s session(s) at refreshInterval %s ≈ %s%% of a core\n' \
      10 "$ok" "$(jq -r '.statusLine.refreshInterval // 1' "$SETTINGS" 2>/dev/null)" \
      "$(awk -v n="$ok" -v r="$(jq -r '.statusLine.refreshInterval // 1' "$SETTINGS" 2>/dev/null)" \
         'BEGIN { printf "%.0f", 10 * n / (r > 0 ? r : 1) / 10 }')"
    [ "$ok" -gt 8 ] && printf '              many sessions — raising refreshInterval to 2 or 3 halves that\n'
  fi

  # Per session, never aggregated. Calibration belongs to one session's turn
  # history, so a total across sessions would report ready while the session you
  # are looking at has nothing.
  if [ "$ESTIMATE" = "0" ]; then
    printf '  estimate    off\n'
  else
    # Driven off the state files rather than the turn files, because a session
    # rewrites its state every render but its turns only when a request lands —
    # so recency on the turns would hide a live session that has been reading
    # for a minute.
    local f n sess any=0
    while read -r f; do
      sess=${f##*/rtc-}; sess=${sess%.state}
      f="$RUN/rtc-$sess.turns"
      [ -r "$f" ] || continue
      n=$(wc -l < "$f"); n=$((n))
      [ "$n" -gt 0 ] || continue
      any=1
      if [ "$n" -lt 3 ]; then
        printf '  estimate    %.8s — %s turn(s), showing a provisional figure (dim until 3)\n' "$sess" "$n"
      else
        printf '  estimate    %.8s — %s turn(s), calibrated\n' "$sess" "$n"
      fi
    done < <(live_states)
    local rf
    for rf in "$CACHE_DIR"/rate-*; do
      [ -r "$rf" ] || continue
      any=1
      printf '  model rate  %s — %s sample(s), inherited by new sessions\n' \
        "${rf##*/rate-}" "$(wc -l < "$rf")"
    done
    [ "$any" = 0 ] && printf '  estimate    no completed turns recorded yet — send a message and it calibrates\n'
  fi
  # A diagnostic that reports everything is fine and then exits 1 breaks any
  # && chain it is put in. The last test above decides the status otherwise.
  return 0
}

case "${1:-statusline}" in
  statusline) cmd_statusline ;;
  hook)       cmd_hook ;;
  halt)       cmd_halt ;;
  setup)      cmd_setup ;;
  uninstall)  cmd_uninstall ;;
  rates)      cmd_rates ;;
  doctor)     cmd_doctor ;;
  -h|--help|help)
    sed -n '2,27p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (try: statusline, hook, halt, setup, uninstall, rates, doctor)" ;;
esac
